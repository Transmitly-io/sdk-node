{
  "name": "@transmitly/sdk",
  "version": "1.32.0",
  "description": "Node.js client for the Transmitly email API",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "README.md"
  ],
  "license": "MIT",
  "keywords": [
    "email",
    "transactional",
    "smtp",
    "webhooks"
  ],
  "scripts": {
    "test": "node --test test.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Transmitly-io/sdk-node.git"
  },
  "homepage": "https://transmitly.io/docs",
  "bugs": {
    "url": "https://github.com/Transmitly-io/sdk-node/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
